# SQLite locally (file: path, relative to the project root); swap the
# provider in prisma/schema.prisma + lib/db.ts's adapter to go to Postgres
# in production. See docs/multi-domain-playbook.md.
DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A fresh secret per instance/environment — never share one across forks.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — the app degrades gracefully without these
RESEND_API_KEY=""
ANTHROPIC_API_KEY=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
